# Copy to .env and fill in. Every variable below is also set on Vercel, except SEED_OWNERS.

# ── Database ────────────────────────────────────────────────────────────────
# Local: `docker compose up -d --wait` (docker-compose.yml), then this URL as-is.
# Production: Prisma Postgres. Either its postgres:// TCP string, or a prisma+postgres://
# Accelerate URL — src/lib/db.ts picks the driver from the scheme.
DATABASE_URL="postgresql://bakery:bakery@localhost:5432/bakery?schema=public"

# ── Seed only ───────────────────────────────────────────────────────────────
# The two OWNER staff rows — the Google sign-in allowlist. Google-only sign-in has no
# password reset: the second owner is the only way back in if the first account is lost.
SEED_OWNERS="Developer <you@gmail.com>, Owner <owner@gmail.com>"

# ── Auth.js ─────────────────────────────────────────────────────────────────
# `openssl rand -base64 32`
AUTH_SECRET=""
# Google Cloud Console → OAuth client. Redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Only for `next start` outside Vercel (Vercel and `next dev` trust the host already).
# AUTH_TRUST_HOST=true
# TEMPORARY, local only: "1" opens /admin/* without signing in, acting as the first owner.
# Ignored on a Vercel production deploy. Never set it on Vercel.
# ADMIN_AUTH_BYPASS=1

# ── Cloudinary ──────────────────────────────────────────────────────────────
# Console → Settings → API Keys. The cloud name is the part after the @ in CLOUDINARY_URL
# (an id like xwgnxhj2, not the account or brand name); key and secret come from the same page.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Telegram ────────────────────────────────────────────────────────────────
# BotFather token. TELEGRAM_CHAT_ID is the fallback chat: once the settings screen's
# connect flow has stored the owner's chat in the database, that one is used instead.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
